    "test:cdn": "playwright test --config playwright.cdn.config.ts",
    "test:tooltips": "playwright test --config playwright.tooltip.config.ts",
    "test:fields-styles": "playwright test --config playwright.fields-styles.config.ts",
    "test:size": "node --test scripts/bundle-size.test.mjs scripts/modular-css.test.mjs && node scripts/bundle-size.mjs",
    "test:docs": "node --test scripts/documentation.test.mjs",
