    "build:public": "node scripts/build-public.mjs",
    "pack:public": "pnpm run build:public && pnpm --dir dist pack --pack-destination ../artifacts",
    "test:public": "node --test scripts/public-package.test.mjs scripts/angular-public-consumer.test.mjs scripts/named-framework-consumer.test.mjs scripts/compact-public-package.test.mjs scripts/public-package-layout.test.mjs",
    "lint:svelte": "svelte-check --tsconfig ./tsconfig.svelte.json",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --outDir dist-gallery",
    "test:api": "node --test scripts/component-api.test.mjs",
    "test:browser": "playwright test",
    "test:pdf-viewer": "playwright test --config playwright.pdf.config.ts",
    "test:visual-audit": "playwright test --config playwright.audit.config.ts",
    "build": "node scripts/build-public.mjs",
    "build:demo": "node scripts/build.mjs",
    "test:discovery": "node --test playwright.test.mjs",
    "test:frameworks": "playwright test --config playwright.framework-adapters.config.ts framework-adapters.spec.ts",
